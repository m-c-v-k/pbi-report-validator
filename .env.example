# Copy to .env and fill in. Never commit .env.
# Only needed for data validation (--data) against published semantic models.
PBI_TENANT_ID=
PBI_CLIENT_ID=
PBI_CLIENT_SECRET=

# Optional AI layer (--ai api). Your own key; the key owner pays for use.
ANTHROPIC_API_KEY=
# Default for --ai: off or api. "disabled" blocks AI whatever the flags say.
PBI_VALIDATE_AI=
# Model override; defaults to the latest Claude model.
PBI_VALIDATE_AI_MODEL=
